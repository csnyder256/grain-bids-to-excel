# Batch files must stay CRLF so cmd.exe parses goto/labels reliably.
*.bat text eol=crlf
*.cmd text eol=crlf

# Mac .command scripts are bash - must stay LF or the shebang line breaks.
*.command text eol=lf

# Everything else: normalize to LF in the repo.
* text=auto
*.py text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# Binary assets - never touch.
*.woff2 binary
*.xlsx binary
*.png binary
*.svg text eol=lf
