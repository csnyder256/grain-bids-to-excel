# grain-bids-to-excel - environment variables
#
# Copy to .env (or just export these in your shell) if you need to override
# the defaults. The app reads NO secrets, API keys or tokens: it scrapes
# public pages and writes local files, so this file exists only to document
# the two switches the code actually reads. Never commit a real .env.
#
# Every variable below was derived from the source, not from a live config:
#   BIDBOARD_NO_BROWSER      app/src/launcher.py
#   PLAYWRIGHT_BROWSERS_PATH app/src/bidboard/services/scan_manager.py,
#                            plus RUN.bat / RUN.command / SETUP.bat / SETUP.command

# Set to 1 to suppress opening a web browser when the server starts.
# Used for headless and test runs; anything other than "1" is ignored.
BIDBOARD_NO_BROWSER=0

# Where Playwright looks for its Chromium download. The launchers set this
# to the app/browsers folder so the whole install stays inside the project
# directory. Override only if you keep browsers elsewhere; leave it unset
# and Playwright falls back to its own per-user cache.
PLAYWRIGHT_BROWSERS_PATH=./app/browsers
